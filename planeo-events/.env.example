NODE_ENV=development
PORT=4200
HOST=0.0.0.0
LOG_LEVEL=info
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true

DATABASE_URL=postgres://authzero:authzero@localhost:5432/planeo_events
DATABASE_SSL=false
DATABASE_POOL_MAX=10

AUTH_ISSUER=http://localhost:4000
AUTH_AUDIENCE=planeo
AUTH_JWKS_URL=http://localhost:4000/.well-known/jwks.json

# Shared with authzero EVENT_WEBHOOK_SECRET (32+ chars)
AUTHZERO_WEBHOOK_SECRET=
# 32 bytes hex, encrypts subscription secrets at rest. Generate: npm run keys:generate
SECRETS_ENCRYPTION_KEY=

WORKER_ENABLED=true
WORKER_ID=
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_QUEUES=default,webhooks,email,system
JOB_TIMEOUT_MS=60000
JOB_LOCK_TIMEOUT_SECONDS=300
JOB_RETENTION_DAYS=14
BACKOFF_BASE_MS=5000
BACKOFF_MAX_MS=3600000
SCHEDULER_ENABLED=true
WEBHOOK_TIMEOUT_MS=10000

APP_BASE_URL=http://localhost:3000
EMAIL_PROVIDER=log
EMAIL_FROM=Planeo <no-reply@planeo.local>
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

CORS_ORIGINS=http://localhost:3000

# Identity assertions from the planeo-management gateway, verified locally
INTERNAL_IDENTITY_KEY=
INTERNAL_IDENTITY_ISSUER=planeo-gateway
INTERNAL_IDENTITY_AUDIENCE=planeo-events

# Mailtrap (EMAIL_PROVIDER=mailtrap). With MAILTRAP_INBOX_ID set, mail is captured
# in that sandbox inbox instead of being delivered.
MAILTRAP_API_KEY=
MAILTRAP_INBOX_ID=
# Find it with: GET https://mailtrap.io/api/accounts/{accountId}/inboxes
