{
  "name": "pleneo-iot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Device registry, telemetry ingestion, rules and command dispatch for Pleneo",
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#config": "./src/config/index.js",
    "#common/*": "./src/common/*",
    "#infra/*": "./src/infrastructure/*",
    "#modules/*": "./src/modules/*"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js | pino-pretty",
    "migrate": "node src/infrastructure/database/migrate.js",
    "simulate": "node scripts/simulate-device.js",
    "keys:generate": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "simulate:mqtt": "node scripts/simulate-mqtt-device.js"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.34",
    "aedes": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jose": "^6.2.15",
    "mqtt": "^5.16.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
