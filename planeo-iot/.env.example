NODE_ENV=development
PORT=4300
HOST=0.0.0.0
LOG_LEVEL=info
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true

DATABASE_URL=postgres://authzero:authzero@localhost:5432/planeo_iot
DATABASE_SSL=false
DATABASE_POOL_MAX=10

AUTH_ISSUER=http://localhost:4000
AUTH_AUDIENCE=planeo
AUTH_JWKS_URL=http://localhost:4000/.well-known/jwks.json

# 32 bytes hex, keys device credential hashes. Generate: npm run keys:generate
DEVICE_SECRET_KEY=

# Ingestion limits
INGEST_MAX_BATCH=500
INGEST_MAX_SKEW_MINUTES=60
INGEST_MAX_BACKFILL_DAYS=30
DEVICE_RATE_LIMIT_PER_MINUTE=600

# Device lifecycle
DEVICE_OFFLINE_AFTER_SECONDS=120
OFFLINE_SWEEP_INTERVAL_MS=30000
COMMAND_DEFAULT_TTL_SECONDS=300
TELEMETRY_RETENTION_DAYS=90

# planeo-events integration (authzero client with scopes: events:publish)
EVENTS_URL=http://localhost:4200
EVENTS_CLIENT_ID=
EVENTS_CLIENT_SECRET=
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000

CORS_ORIGINS=http://localhost:3000

# Identity assertions from the planeo-management gateway, verified locally
INTERNAL_IDENTITY_KEY=
INTERNAL_IDENTITY_ISSUER=planeo-gateway
INTERNAL_IDENTITY_AUDIENCE=planeo-iot

# MQTT device plane. Devices authenticate with the same device token as the HTTP plane.
MQTT_ENABLED=true
MQTT_HOST=0.0.0.0
MQTT_PORT=1883
MQTT_MAX_PAYLOAD_BYTES=131072
MQTT_CONNECT_TIMEOUT_MS=15000
# Set both together to serve MQTT over TLS
MQTT_TLS_KEY_PATH=
MQTT_TLS_CERT_PATH=
