NODE_ENV=development
PORT=4100
HOST=0.0.0.0
LOG_LEVEL=info
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true

DATABASE_URL=postgres://authzero:authzero@localhost:5432/planeo
DATABASE_SSL=false
DATABASE_POOL_MAX=10

AUTH_ISSUER=http://localhost:4000
AUTH_AUDIENCE=planeo
AUTH_JWKS_URL=http://localhost:4000/.well-known/jwks.json

# Optional: verify revocation state with authzero introspection (needs a client with any scope)
AUTH_INTROSPECTION_ENABLED=false
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_INTROSPECTION_CACHE_SECONDS=60

CORS_ORIGINS=http://localhost:3000

# planeo-events integration (client credentials from authzero with scopes: events:publish jobs:enqueue)
EVENTS_URL=http://localhost:4200
EVENTS_CLIENT_ID=
EVENTS_CLIENT_SECRET=
# Secret printed by planeo-events `npm run seed:subscription`
EVENTS_WEBHOOK_SECRET=
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
NOTIFY_EMAIL_ENABLED=false

# planeo-iot, reached only through the BFF proxy
IOT_URL=http://localhost:4300

# BFF token handler: the browser holds an opaque session cookie, never a token
BFF_ENABLED=true
# 32 bytes hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BFF_SESSION_KEY=
BFF_COOKIE_NAME=planeo_session
BFF_CSRF_COOKIE_NAME=planeo_csrf
BFF_COOKIE_SECURE=false
BFF_SESSION_TTL_DAYS=30
BFF_REFRESH_SKEW_SECONDS=60

# Gateway: identity assertions minted for upstreams so they need not call authzero
# 32 bytes hex, shared with planeo-events and planeo-iot
INTERNAL_IDENTITY_KEY=
INTERNAL_IDENTITY_ISSUER=planeo-gateway
INTERNAL_IDENTITY_TTL_SECONDS=60
GATEWAY_TIMEOUT_MS=10000
GATEWAY_BREAKER_THRESHOLD=5
GATEWAY_BREAKER_RESET_MS=15000
GATEWAY_MAX_RESPONSE_BYTES=2000000
GATEWAY_RATE_LIMIT_PER_MINUTE=300
