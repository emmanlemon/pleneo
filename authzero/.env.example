NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
TRUST_PROXY=0

DATABASE_URL=postgres://authzero:authzero@localhost:5432/authzero
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# 32 bytes hex. Generate: npm run keys:generate-kek
KEY_ENCRYPTION_KEY=

JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=planeo
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MFA_CHALLENGE_TTL_SECONDS=300
SIGNING_KEY_ROTATION_DAYS=90

REQUIRE_EMAIL_VERIFICATION=true
EMAIL_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_HISTORY_SIZE=5
ADMIN_REQUIRE_MFA=false

CORS_ORIGINS=http://localhost:3000
COOKIE_NAME=rt
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Optional outbound webhook for emails/events (HMAC signed)
EVENT_WEBHOOK_URL=
EVENT_WEBHOOK_SECRET=
