# Generated for the local Docker stack. Do not reuse these values anywhere else.
POSTGRES_PASSWORD=

# Secrets at rest
AUTHZERO_KEK=
EVENTS_SECRETS_KEY=
IOT_DEVICE_SECRET_KEY=

# Signed webhooks
AUTHZERO_WEBHOOK_SECRET=
MANAGEMENT_WEBHOOK_SECRET=

# Service clients seeded into authzero
MGMT_CLIENT_ID=cid_pleneo_management
MGMT_CLIENT_SECRET=
IOT_CLIENT_ID=cid_pleneo_iot
IOT_CLIENT_SECRET=

# Seeded administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Adm1n-Str0ng-Passw0rd!

# Optional
EMAIL_PROVIDER=log
EMAIL_FROM=Pleneo <no-reply@pleneo.local>
NOTIFY_EMAIL_ENABLED=false
DEVICE_OFFLINE_AFTER_SECONDS=120
DOCS_ENABLED=true

# BFF session encryption (pleneo-management gateway)
BFF_SESSION_KEY=

# Gateway to upstream identity assertions (shared by management, events and iot)
INTERNAL_IDENTITY_KEY=

# Mailtrap. Set MAILTRAP_INBOX_ID to capture mail in a sandbox inbox instead of really sending it.
MAILTRAP_API_KEY=
MAILTRAP_INBOX_ID=


# Trust an extra root CA for outbound TLS. Needed on networks that inspect TLS.
# The repo mounts ./docker/ca read-only at /etc/pleneo-ca in the events service.
NODE_EXTRA_CA_CERTS=
